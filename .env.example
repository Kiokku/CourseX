# Copy to .env. Model settings are configured through the web page.
PORT=4310
HOST=0.0.0.0
# Use an external course library. Adjust this path for your machine.
COURSEX_LIBRARY=/Volumes/Steam/CourseXLibrary
# If COURSEX_LIBRARY is unset, the app and downloader fall back to library/ in this project.
# Learning data defaults to .coursex-data/ in this project.
# COURSEX_DATA=/absolute/path/to/data
# A valid tldraw key is required for production. Obtain your own hobby/trial/commercial key.
# TLDRAW_LICENSE_KEY=
